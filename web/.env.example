# Nimbus web — environment.
#
# Copy to `.env.local` for development. On Vercel these go in Project Settings -> Environment
# Variables. `.env.local` is git-ignored; the only value here that is safe to commit anywhere is
# NIMBUS_LICENCE_PUBLIC_KEY, and even that is kept out of git because it varies per deployment.
#
# ── Required ────────────────────────────────────────────────────────────────────

# Postgres. Neon, Supabase or Vercel Postgres all work. DATABASE_URL should be the *pooled*
# connection (serverless opens many short-lived connections); DIRECT_DATABASE_URL is the direct one,
# used by `prisma db push` and migrations.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Signs every licence token. THE one secret: if it leaks, licences are forgeable and the only remedy
# is a new keypair plus a new desktop build. Generate with `npm run keygen`.
NIMBUS_LICENCE_PRIVATE_KEY=""

# The public half. Not a secret — it only verifies. Set it so /healthz can prove the pair matches
# before a customer does.
NIMBUS_LICENCE_PUBLIC_KEY=""

# Signs session cookies. 32+ characters of randomness. Changing it signs everyone out.
AUTH_SECRET=""

# Public origin of this deployment. Stripe return URLs and email links are built from it.
SITE_URL="http://localhost:3000"

# ── Payments: Stripe ───────────────────────────────────────────────────────────
# Missing these is fine: the card button falls back to the EasyPaisa route instead of failing.

STRIPE_SECRET_KEY=""
# The price ID, not the product ID. It is the hardest of these to find in the dashboard: it is not on the
# product header, it is the row beneath Pricing, and `GET /v1/prices?product=prod_…` is quicker than
# hunting for it. Starts `price_`, and a `prod_` here fails at checkout rather than at startup.
STRIPE_PRICE_ID=""

# No Stripe trial period, deliberately. Nimbus's 7-day trial is device-bound, needs no card and is granted
# by our own licence service; a `trial_period_days` on the price would stack a second trial on top.
# From `stripe listen` in development, or the endpoint's signing secret in the dashboard.
STRIPE_WEBHOOK_SECRET=""

# ── Payments: EasyPaisa and bank transfer ──────────────────────────────────────
# The manual route needs only the account details below and works today.

EASYPAISA_ACCOUNT_NUMBER=""
EASYPAISA_ACCOUNT_NAME=""
BANK_NAME=""
BANK_ACCOUNT_NUMBER=""
BANK_IBAN=""
# The name on the account. Not optional in practice: banks and the EasyPaisa app both ask for the
# beneficiary name and reject a transfer that does not match it.
BANK_ACCOUNT_TITLE=""
# Only needed for an international wire, and labelled that way on /pay. Inside Pakistan the IBAN is enough.
BANK_SWIFT=""

# What the site quotes locally, and what the hosted checkout charges. Set deliberately rather than
# converted at request time: a rate that moves mid-checkout is how a payment ends up rejected.
PRICE_PKR=""
PRICE_PKR_AMOUNT=""

# EasyPaisa's own hosted checkout. Needs a merchant account — see web/README.md. Leave blank until
# you have one and the manual route is used instead.
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
EASYPAISA_MODE="sandbox"

# ── Email ──────────────────────────────────────────────────────────────────────
# Without either key, licence keys still work and still show on the account page; they just are not
# emailed. The desktop TRIAL is the exception: it needs the 6-digit code, so it fails outright.
#
# Two providers, and which one you need depends on whether you own a domain:
#
#   BREVO_API_KEY   Brevo verifies a single SENDER ADDRESS, no DNS. Use this on a deployment with no
#                   domain of its own -- a *.vercel.app origin has no DNS zone to put records in.
#                   Set up: create the key, then add EMAIL_FROM's address under Senders and click the
#                   link Brevo emails to it. Without that step every send fails "sender not valid".
#   RESEND_API_KEY  Resend requires a verified DOMAIN and will only deliver to the account owner's own
#                   address until you have one. Use it when you have a domain to authenticate.
#
# Brevo wins when both are set. Caveat worth knowing: a sender on a domain you have not authenticated
# is subject to Gmail's and Yahoo's bulk-sender rules, so delivery there is best-effort and can land in
# spam. Nothing critical depends on it -- a licence key activates the app with no email in the path.

BREVO_API_KEY=""
RESEND_API_KEY=""
EMAIL_FROM="Nimbus <wolfhoghd@gmail.com>"
EMAIL_REPLY_TO="wolfhoghd@gmail.com"

# ── Admin ──────────────────────────────────────────────────────────────────────
# Bearer token for /admin. Unset means the endpoint refuses everyone, which is the safe default.

ADMIN_TOKEN=""

# ── The download ───────────────────────────────────────────────────────────────

# The `latest/download/<name>` form only works if a release asset has *exactly* that name, so the release
# workflow publishes a stable `Nimbus-Windows-Setup.exe` alongside the versioned one. Point this at a
# versioned asset instead if you are deploying before the next release runs.
NIMBUS_DOWNLOAD_URL="https://github.com/ArhamKhan117/Nimbus/releases/latest/download/Nimbus-Windows-Setup.exe"
